generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id          Int      @id @default(autoincrement())
  admissionNo String   @unique
  name        String
  mobile      String?
  course      String
  fee         Int      @default(0)
  paid        Int      @default(0)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
}

model Course {
  id        Int      @id @default(autoincrement())
  name      String
  duration  String
  fee       Int
  category  String
  createdAt DateTime @default(now())
}
